{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "types": []
  },
  "include": ["src", "../src/lib/order.ts", "../src/lib/pricing.ts", "../src/lib/stock.ts", "../src/lib/catalog.ts", "../src/lib/ageCheck.ts", "../src/data/types.ts"]
}
