rules_version = '2';

// Who can read and change what.
//   Everyone: read the shop (products, photos, settings) and place orders.
//   Customers: read their own orders and profile.
//   Staff (admins/{uid}): change the shop and see every order.
//   Main account (meta/firstAdmin): also adds and removes staff.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isMain() {
      return signedIn() && exists(/databases/$(database)/documents/meta/firstAdmin)
        && get(/databases/$(database)/documents/meta/firstAdmin).data.uid == request.auth.uid;
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }
    // Shoppers may lower a product's stock count only in the same write that
    // places the order using it (the order must not exist before, and must after).
    function stockFromNewOrder() {
      let d = request.resource.data;
      let o = resource.data;
      return d.diff(o).affectedKeys().hasOnly(['stock', 'status', 'lastOrderId'])
        && d.stock is number && o.stock is number
        && d.stock >= 0 && d.stock < o.stock && o.stock - d.stock <= 500
        && d.status in ['in', 'low', 'out']
        && d.lastOrderId is string
        && !exists(/databases/$(database)/documents/orders/$(d.lastOrderId))
        && existsAfter(/databases/$(database)/documents/orders/$(d.lastOrderId));
    }

    match /products/{id} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() || stockFromNewOrder();
    }
    match /photos/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // The very first staff account claims the main-account slot, once.
    match /meta/firstAdmin {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create: if isMain()
        || (signedIn() && uid == request.auth.uid
            && !exists(/databases/$(database)/documents/meta/firstAdmin)
            && getAfter(/databases/$(database)/documents/meta/firstAdmin).data.uid == request.auth.uid);
      allow update: if isMain();
      allow delete: if isMain() && uid != request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isStaff();
    }

    match /orders/{id} {
      allow create: if request.resource.data.status == 'new'
        && (!('customerId' in request.resource.data)
            || (signedIn() && request.resource.data.customerId == request.auth.uid));
      allow read: if isStaff()
        || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isStaff();
    }
  }
}
